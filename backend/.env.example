PORT=5000
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=minifour

# Google Drive service account for image storage.
GOOGLE_SERVICE_ACCOUNT_EMAIL=minifour-images@minifour-4719.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreplace-with-your-private-key\n-----END PRIVATE KEY-----
GOOGLE_DRIVE_FOLDER_ID=1luIeBh42nCyc9i8UYRHJ_MgXyVEDBPGG

# Cloudinary (legacy, still used for QR fallback and optional cleanup).
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
MTN_MOMO_ENVIRONMENT=sandbox
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_TARGET_ENVIRONMENT=sandbox
MTN_MOMO_SUBSCRIPTION_KEY=your_subscription_key
MTN_MOMO_API_USER=your_api_user_uuid
MTN_MOMO_API_KEY=your_api_key
MTN_MOMO_CURRENCY=RWF
MTN_MOMO_TIMEOUT_MS=15000

# Comma separated list of browser origins allowed to call the API.
FRONTEND_URL=http://localhost:5173

# Seeded accounts created on first boot.
ADMIN_EMAIL=admin@minifour.com
ADMIN_PASSWORD=Admin@Minifour123
CHEF_EMAIL=chef@minifour.com
CHEF_PASSWORD=Chef@Minifour123

# API rate limiting (per window, in milliseconds).
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=30
ORDER_RATE_LIMIT_MAX=30
